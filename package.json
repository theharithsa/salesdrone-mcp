{
  "name": "@theharithsa/salesdrone-mcp",
  "version": "1.1.0",
  "description": "Read-only MCP tools for SalesDrone leads, recorded team activity and people",
  "type": "module",
  "bin": {
    "salesdrone-mcp": "src/cli.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "author": "Avinya Enterprises",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theharithsa/salesdrone-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/theharithsa/salesdrone-mcp/issues"
  },
  "homepage": "https://github.com/theharithsa/salesdrone-mcp#readme",
  "keywords": [
    "mcp",
    "salesdrone",
    "crm",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:protocol": "node --test test/protocol.test.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-package.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@theharithsa/opentelemetry-instrumentation-mcp": "0.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "jszip": "3.10.1",
    "protobufjs": "7.6.6"
  }
}
